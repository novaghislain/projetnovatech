{
  "experimentalServices": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
